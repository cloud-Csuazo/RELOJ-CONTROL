# Development en Supabase Cloud. Copiar como .env.local.
APP_ENV=development
APP_URL=http://127.0.0.1:3000
SUPABASE_URL=https://TU_PROYECTO_DEV.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Sólo servidor: rate limiting compartido. Nunca NEXT_PUBLIC ni cliente UI.
SUPABASE_SECRET_KEY=
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_HMAC_SECRET=
# IP: no confiar en cabeceras de un cliente. none usa bucket por correo.
TRUSTED_PROXY=none
# Regla aprobada: sólo ADMIN_GLOBAL, dentro de empresas asignadas.
ENABLE_ACCESS_MANAGEMENT=true
# Ref del proyecto separado de desarrollo; el seed rechaza otro destino.
DEV_SUPABASE_PROJECT_REF=
