{
  "name": "suacof-cloud9-foundations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/unit/*.test.ts tests/database/*.test.ts",
    "test:e2e": "playwright test",
    "test:live": "tsx --test tests/live/*.test.ts",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "cloud:sql": "node scripts/prepare-cloud-sql.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:stop": "supabase stop",
    "seed:users": "tsx scripts/seed-users.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "supabase": "2.118.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.19.0"
}
